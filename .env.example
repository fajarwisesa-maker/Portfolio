# Copy to .env.local (never commit .env.local).

# Realtime guestbook + coffee (Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Contact form email (Resend, free tier). Without a key the form opens the visitor's email app instead.
RESEND_API_KEY=
# Where messages go (default: the email in lib/content.ts)
CONTACT_TO=
# Sender shown in your inbox. Default works for testing; use your own verified domain later.
CONTACT_FROM=Portfolio <onboarding@resend.dev>
